rules_version = '2';

// RÈGLES DE SÉCURITÉ FIRESTORE — à coller dans Firebase > Firestore Database > Règles > Publier
// Avant de publier : remplacez l'adresse de l'enseignante dans la fonction isAdmin() (en minuscules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Seule cette adresse (vérifiée par le lien de connexion) accède à la gestion.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['REMPLACER-PAR-ADRESSE-ENSEIGNANTE@exemple.fr'];
    }

    // Collecte ouverte : réglage « open » vrai ET date limite non dépassée.
    function collectOpen() {
      let s = get(/databases/$(database)/documents/config/settings).data;
      return s.open == true && request.time < s.deadline;
    }

    function okLink(v) { return v is string && (v == '' || (v.matches('https://[^ ]+') && v.size() <= 500)); }
    function okImage(v) { return v is string && v.size() < 700000 && (v == '' || v.matches('data:image/jpeg;base64,.*')); }

    function okContent(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.members is string && d.members.size() <= 500
        && d.summary is string && d.summary.size() <= 800
        && d.languages is string && d.languages.size() <= 150
        && d.theme is string && d.theme.size() <= 1000
        && okLink(d.corpusLink) && okLink(d.presentationLink)
        && okImage(d.imageData)
        && d.imageAlt is string && d.imageAlt.size() <= 250
        && d.imageCredit is string && d.imageCredit.size() <= 150
        && d.consent is bool;
    }

    // Champs obligatoires pour une fiche envoyée (le lien de présentation reste facultatif à l'envoi).
    function complete(d) {
      return d.members.size() > 0 && d.summary.size() > 0 && d.languages.size() > 0 && d.theme.size() > 0
        && d.imageData != '' && d.imageAlt.size() > 0 && d.imageCredit.size() > 0 && d.consent == true;
    }

    function allowedKeys() {
      return ['title', 'members', 'summary', 'languages', 'theme', 'corpusLink', 'presentationLink',
              'imageData', 'imageAlt', 'imageCredit', 'consent', 'ownerUid', 'ownerEmail', 'status',
              'published', 'publishedAt', 'adminComment', 'createdAt', 'updatedAt'];
    }

    // Paramètres de collecte : lisibles par tous (la date limite n'est pas sensible), modifiables par l'enseignante.
    match /config/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fiches publiées : seule collection lisible publiquement. Elle ne contient AUCUNE adresse e-mail.
    match /publications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fiches de travail : visibles uniquement par leur groupe et par l'enseignante.
    match /fiches/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn() && collectOpen()
        && request.resource.data.keys().hasOnly(allowedKeys())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status in ['brouillon', 'envoyee']
        && request.resource.data.published == false
        && request.resource.data.publishedAt == 0
        && request.resource.data.adminComment == ''
        && okContent(request.resource.data)
        && (request.resource.data.status == 'brouillon' || complete(request.resource.data));

      allow update: if isAdmin()
        || (signedIn() && collectOpen()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status in ['brouillon', 'envoyee', 'modifs']
          && request.resource.data.keys().hasOnly(allowedKeys())
          && request.resource.data.status in ['brouillon', 'envoyee']
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.published == resource.data.published
          && request.resource.data.publishedAt == resource.data.publishedAt
          && request.resource.data.adminComment == resource.data.adminComment
          && request.resource.data.createdAt == resource.data.createdAt
          && okContent(request.resource.data)
          && (request.resource.data.status == 'brouillon' || complete(request.resource.data)));

      allow delete: if isAdmin()
        || (signedIn() && collectOpen() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'brouillon');
    }
  }
}
